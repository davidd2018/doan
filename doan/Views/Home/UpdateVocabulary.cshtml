@{
}
@model Bai01Model

@{
    ViewData["Title"] = "Thêm Từ Vựng";
}

<h1>Thêm Từ Vựng Mới</h1>

<form asp-action="UpdateVocabulary" method="post">
    <div>
        <label>Từ Vựng</label>
        <input asp-for="TuVung" class="form-control" required />
    </div>
    <div>
        <label>Hán Tự</label>
        <input asp-for="HanTu" class="form-control" />
    </div>
    <div>
        <label>Âm Hán</label>
        <input asp-for="AmHan" class="form-control" />
    </div>
    <div>
        <label>Phát Âm</label>
        <input asp-for="PhatAm" class="form-control" />
    </div>
    <div>
        <label>Nghĩa</label>
        <input asp-for="Nghia" class="form-control" required />
    </div>
</form>