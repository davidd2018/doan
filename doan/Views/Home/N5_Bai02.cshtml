@{
    ViewData["Title"] = "N5_Bai01";
}

@{
    Layout = null; // Use null if you are not using a shared layout, or define it as per your project
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Webpage Layout</title>
    <link rel="stylesheet" href="~/css/N5_Bai02.css"/>
</head>
<body>
    <div class="header">
        <h1>
            <a href="~/Home/Index">Trang Chu</a>
        </h1>
    </div>
    <div class="container">
        <div class="side-banner">
        </div>
        <div class="main-container">

            <h1>Bảng Từ Vựng Tiếng Nhật</h1>
            <table>
                <style>
                    body {
                        font-family: Arial, sans-serif;
                        margin: 20px;
                        background-color: #f9f9f9;
                    }

                    table {
                        width: 100%;
                        border-collapse: collapse;
                        margin: 20px 0;
                    }

                    th, td {
                        border: 1px solid #ccc;
                        padding: 8px;
                        text-align: left;
                    }

                    th {
                        background-color: #f2f2f2;
                    }
                </style>
                <thead>
                    <tr>
                        <th>Từ Vựng</th>
                        <th>Hán Tự</th>
                        <th>Âm Hán</th>
                        <th>Phát Âm</th>
                        <th>Nghĩa</th>
                    </tr>
                </thead>
                @model List<doan.Models.Bai01Model>
                @{
                    ViewData["Title"] = "N5_Bai01";
                }

                @{
                    Layout = null; // Use null if you are not using a shared layout, or define it as per your project
                }

                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Webpage Layout</title>
                    <link rel="stylesheet" href="~/css/N5_Bai02.css" />
                </head>
                <body>
                    <div class="header">
                        <h1>
                            <a href="~/Home/Index">Trang Chu</a>
                        </h1>
                    </div>
                    <div class="container">
                        <div class="side-banner">
                        </div>
                        <div class="main-container">

                            <h1>Bảng Từ Vựng Tiếng Nhật</h1>
                            <table>
                                <style>
                                    body {
                                        font-family: Arial, sans-serif;
                                        margin: 20px;
                                        background-color: #f9f9f9;
                                    }

                                    table {
                                        width: 100%;
                                        border-collapse: collapse;
                                        margin: 20px 0;
                                    }

                                    th, td {
                                        border: 1px solid #ccc;
                                        padding: 8px;
                                        text-align: left;
                                    }

                                    th {
                                        background-color: #f2f2f2;
                                    }
                                </style>
                                <thead>
                                    <tr>
                                        <th>Từ Vựng</th>
                                        <th>Phát Âm</th>
                                        <th>Âm Hán</th>
                                        <th>Hán tự<h /th>
                                        <th>Nghĩa</th>
                                    </tr>
                                </thead>

                                @if (Model != null && Model.Count > 0) // Kiểm tra Model có dữ liệu hay không
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrEmpty(item.TuVung) ? "Không có" : item.TuVung)</td>
                                            <td>@(string.IsNullOrEmpty(item.PhatAm) ? "Không có" : item.PhatAm)</td>
                                            <td>@(string.IsNullOrEmpty(item.AmHan) ? "Không có" : item.AmHan)</td>
                                            <td>@(string.IsNullOrEmpty(item.HanTu) ? "Không có" : item.HanTu)</td>
                                            <td>@(string.IsNullOrEmpty(item.Nghia) ? "Không có" : item.Nghia)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5">Không có dữ liệu!</td>
                                    </tr>
                                }

                                <!-- Hàng nhập liệu để thêm từ vựng mới -->
                                <tr>
                                    <form asp-action="Create" method="post">
                                    <td><input type="text" name="TuVung" required placeholder="Nhập từ vựng..." /></td>
                                    <td><input type="text" name="PhatAm" placeholder="Nhập Phát Âm..." /></td>
                                    <td><input type="text" name="AmHan" placeholder="Nhập Âm Hán..." /></td>
                                    <td><input type="text" name="HanTu" placeholder="Nhập Hán tự..." /></td>
                                    <td><input type="text" name="Nghia" required placeholder="Nhập nghĩa..." /></td>
                                    <td>
                                        <button type="submit" class="btn btn-primary">Thêm</button>
                                    </td>
                                    </form>
                                </tr>
                                </tbody>
            </table>
            <hr />
            <h1><center>Ngữ Pháp</center></h1><br />
            <div class="nguphap">
                <section>
                    <h2>1.これ/ それ/ あれ</h2><br />
                    <p><strong>これ、それ、あれ là những từ chỉ vật và có chức năng như 1 danh từ</strong></p><br />
                    <p>これ được dùng để chỉ những vật ở gần người nói (Tôi là học sinh.)</p><br />
                    <p>それ được dùng để chỉ những vật ở gần người nghe</p><br />
					<p>あれ được dùng để chỉ những vật ở xa cả người nói và người nghe</p><br />
                    <p>これは　じしょですか。 (Đây là quyển từ điển phải không?)</p><br />
                    <p>あれは　何（なん）ですか。 (Kia là cái gì?)</p><br />

                    <<h2>2.このN/ そのN/ あのN</h2><br />
                    <p><strong>この」、「その」、「あの」là những từ dùng để bổ nghĩa cho danh từ đứng đằng sau nó.</strong></p><br />
                    <p>この　dùng để bổ nghĩa cho những danh từ chỉ những vật ở gần người nói.</p><br />
                    <p>その  dùng để bổ nghĩa cho những danh từ chỉ những vật ở gần người.</p><br />
                    <p>あの  dùng để bổ nghĩa cho những danh từ chỉ những vật ở xa cả người nói và người nghe.</p><br />
                    <p>このほんは　何（なん）の　ほんですか。 (Quyển sách này là sách gì ?)</p><br />
                    <p>そのほんは　えいごの　ほんです。 (Quyển sách đó là sách tiếng Anh.)</p><br />
                    <p>あの方　は　どなたですか。 (Vị đó là ai ?)</p><br />

                    <h2>3.そうです/ そうじゃ　ありません</h2><br />
                    <p><strong>そう」được sử dụng để trả lời vắn tắt cho một câu nghi vấn danh từ ( câu nghi vấn mà tận cùng bằng những danh từ).「はい、そうです」 là câu trả lời khẳng định và「いいえ、そうじゃ　ありません」 là câu trả lời phủ định.</strong></p><br />
                    <p>A：それは　ラジカセ　ですか。(Bạn có phải là học sinh không?)</BR>B1：いいえ、ラジカセではありません。 </p><br />
                </section>
            </div>

        </div>
        @* <div class="side-banner"> *@

        @* </div> *@
    </div>
    <div class="footer">
        <p></p>
    </div>
</body>
</html>
