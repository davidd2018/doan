@model List<doan.Models.Bai01Model>
@{
    ViewData["Title"] = "N5_Bai01";
}

@{
    Layout = null; // Use null if you are not using a shared layout, or define it as per your project
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Webpage Layout</title>
    <link rel="stylesheet" href="~/css/N5_Bai01.css"/>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js"></script>
</head>
<body>
    <div class="header">
        <h1>
            <a href="~/Home/Index">Trang Chu</a>
        </h1>
    </div>
    <div class="container">
        <div class="side-banner">
            
        </div>
        <div class="main-container">
            
                <h1>Bảng Từ Vựng Tiếng Nhật</h1>
                <table>
                    <style>
                        body {
                            font-family: Arial, sans-serif;
                            margin: 20px;
                            background-color: #f9f9f9;
                        }

                        table {
                            width: 100%;
                            border-collapse: collapse;
                            margin: 20px 0;
                        }

                        th, td {
                            border: 1px solid #ccc;
                            padding: 8px;
                            text-align: left;
                            color: black
                        }

                        th {
                            background-color: #f2f2f2;
                        }

                    .edit-btn {
                        display: none;
                        background: #007bff;
                        color: white;
                        border: none;
                        cursor: pointer;
                        padding: 5px;
                        border-radius: 4px;
                    }

                    tr:hover .edit-btn {
                        display: inline-block;
                    }

                    .edit-row {
                        display: none;
                    }

                    .save-btn {
                        background: #28a745;
                        color: white;
                        border: none;
                        cursor: pointer;
                        padding: 5px;
                        border-radius: 4px;
                    }

                    .input-row {
                        display: none;
                    }

                    </style>
                    <thead>
                        <tr>
						<th>ID</th>
                            <th>Từ Vựng</th>
                            <th>Phát Âm</th>
                            <th>Âm Hán</th>
                            <th>Hán tự</th>
                            <th>Nghĩa</th>
                        </tr>
                    </thead>

                @if (Model != null && Model.Count > 0) // Kiểm tra Model có dữ liệu hay không
                {
                    foreach (var item in Model)
                    {
                       
                        <tr>

       @*                      <td>@(string.IsNullOrEmpty(item.TuVung) ? "Không có" : item.TuVung)</td> *@
       @*                      <td>@(string.IsNullOrEmpty(item.PhatAm) ? "Không có" : item.PhatAm)</td> *@
       @*                      <td>@(string.IsNullOrEmpty(item.AmHan) ? "Không có" : item.AmHan)</td> *@
       @*                      <td>@(string.IsNullOrEmpty(item.HanTu) ? "Không có" : item.HanTu)</td> *@
							@* <td>@(string.IsNullOrEmpty(item.Nghia) ? "Không có" : item.Nghia)</td> *@
                            <td class="text-cell">@item.Id</td>
                            <td class="text-cell">@item.TuVung</td>
                            <td class="text-cell">@item.PhatAm</td>
                            <td class="text-cell">@item.AmHan</td>
                            <td class="text-cell">@item.HanTu</td>
                            <td class="text-cell">@item.Nghia</td>

                            @* //Phần nút sửa bên bảng *@
                            <td><button class="edit-btn">...</button></td>

                            <!-- Hidden row for textboxes -->
                        <tr class="input-row">

                            <td><input type="text" class="edit-Id" value="@item.Id">ID</td>
                            <td><input type="text" class="edit-tuVung" value="@item.TuVung"></td>
                            <td><input type="text" class="edit-phatAm" value="@item.PhatAm"></td>
                            <td><input type="text" class="edit-amHan" value="@item.AmHan"></td>
                            <td><input type="text" class="edit-hanTu" value="@item.HanTu"></td>
                            <td><input type="text" class="edit-nghia" value="@item.Nghia"></td>
                            <td><button class="save-btn">Lưu</button></td>

                        </tr>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">Không có dữ liệu</td>
                    </tr>
                }
                <div id="editForm" style="display: none;"></div>


                    <!-- Hàng nhập liệu để thêm từ vựng mới -->
                    <tr>
                        <form asp-action="Create" method="post">
                        <td><input type="text" name="TuVung" required placeholder="Nhập từ vựng..." /></td>
                    <td><input type="text" name="PhatAm" placeholder="Nhập Phát Âm..." /></td>
                        <td><input type="text" name="AmHan" placeholder="Nhập Âm Hán..." /></td>
                    <td><input type="text" name="HanTu" placeholder="Nhập Hán tự..." /></td>
                        <td><input type="text" name="Nghia" required placeholder="Nhập nghĩa..." /></td>
                        <td>
                            <button type="submit" class="btn btn-primary">Thêm</button>
                        </td>
                        </form>
                    </tr>

                </tbody>
                </table>
                <hr />
			<h1><center>Ngữ Pháp</center></h1><br />
                <div class="nguphap">
                    <section>
                    <h2>1. Cấu trúc câu khẳng định</h2><br />
                        <p><strong>A は B です。</strong></p><br />
                        <p>わたしは学生です。 (Tôi là học sinh.)</p><br />
                    <p>あなたは日本人です。 (Bạn là người Nhật.)</p><br />

                    <h2>2. Câu phủ định</h2><br />
                    <p><strong>A は B ではありません。</strong></p><br />
                    <p>わたしは学生ではありません。 (Tôi không phải là học sinh.)</p><br />

                    <h2>3. Câu nghi vấn</h2><br />
                    <p><strong>A は B ですか？</strong></p><br />
                    <p>あなたは学生ですか？ (Bạn có phải là học sinh không?)</p><br />
                    </section>
                </div>

        </div>
        @* <div class="side-banner"> *@
          
        @* </div> *@
    </div>
    <div class="footer">
        <p></p>
    </div>
</body>
</html>
