@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Nhúng file CSS -->
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<div class="container mx-auto p-4">
    <!-- Header -->
    <div class="flex justify-between items-center border-b pb-2 mb-4">
        <h1>Hello World</h1>
        <div class="text-lg">Trang chủ</div>
        <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-1">
                <span>Đang chỉnh sửa:</span>
                <img alt="Vietnam flag" class="w-5 h-5" height="20"
                     src="https://storage.googleapis.com/a1aa/image/YYHQykJcae2FXckO6D83JoUoGmKSUjCFaQUdXMmHE4I.jpg" width="20" />
            </div>
            <div class="relative">
                <button class="flex items-center space-x-1">
                    <span>Tiếng Việt</span>
                    <i class="fas fa-caret-down"></i>
                </button>
            </div>
            <div class="flex space-x-2">
                <button class="btn">Đăng nhập</button>
                <button class="btn">Đăng ký</button>
            </div>
            
        </div>
    </div>

    <!-- Main Content -->
    <div class="text-center mb-8">
        <h1 class="text-3xl">Trang chủ</h1>
        <a class="text-blue-500" href="#">Logo (a href)</a>
    </div>

    <div class="flex justify-center mb-8">
        <div class="w-full md:w-1/2">
            <h2 class="text-lg text-center">Học tiếng Nhật từ N5 - N3</h2>
            <img class="w-full h-auto" height="400"
                 src="https://storage.googleapis.com/a1aa/image/HvB8j3VnQT2z-zM3fnxjnxOD0kXS8xjRIVLylkLMTPU.jpg" width="600" />
        </div>
    </div>

    <div class="text-center mb-8">
        <h2 class="text-lg">Bắt đầu học ngay!</h2>
        <button class="btn">Bấm vào đây</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="col-span-1 text-center">
            <h2 class="text-lg">Học từ vựng</h2>
            <img class="w-full h-auto" height="300"
                 src="https://storage.googleapis.com/a1aa/image/g_muQKQU5q0Nofanks7MBs04BIVohhWF_FfsWE5iJdc.jpg" width="400" />
            <a class="text-lg text-blue-500 block mt-2" href="https://example.com/hoc-tu-vung">Click vào đây</a>
        </div>
        <div class="col-span-1 text-center">
            <h2 class="text-lg">Học ngữ pháp</h2>
            <img class="w-full h-auto" height="300"
                 src="https://storage.googleapis.com/a1aa/image/wnOhn2QS1Hkf3N5eoQxXj1LEOTqB4lSPQ6b9JuVM9Wk.jpg" width="400" />
            <a class="text-lg text-blue-500 block mt-2" href="https://example.com/hoc-ngu-phap">Click vào đây</a>
        </div>
        <div class="col-span-1 text-center">
            <h2 class="text-lg">Mini test</h2>
            <img class="w-full h-auto" height="300"
                 src="https://storage.googleapis.com/a1aa/image/KMhXzNrEOBei-JTV3u_87_HMhtOVUtkrUEvCUPZDeng.jpg" width="400" />
            <a class="text-lg text-blue-500 block mt-2" href="https://example.com/mini-test">Click vào đây</a>
        </div>
    </div>
</div>
