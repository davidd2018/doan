@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Nhúng file CSS -->
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<div class="container mx-auto p-4">
    <!-- Header -->
    <div class="flex justify-between items-center border-b pb-2 mb-4">
        <div class="flex items-center space-x-4">
            <div class="text-lg font-bold">Trang chủ</div>

            <!-- Danh sách liên kết đến các trang khác -->
            <ul class="flex space-x-4 text-blue-500">
                <li><a href="/Home/ChonLevel"> Cấp độ N5</a></li>
            </ul>
        </div>

        <div class="flex items-center space-x-4">
            <div class="flex space-x-2">
                <a asp-area="Identity" asp-page="/Account/Login" class="btn bg-blue-500 text-white px-4 py-2 rounded">Đăng nhập</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn bg-green-500 text-white px-4 py-2 rounded">Đăng ký</a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex justify-center mb-8">
        <div class="w-full md:w-1/2">
            <h2 class="text-lg text-center">Học tiếng Nhật từ N5 - N3</h2>
            <img class="w-full h-auto" height="300"
                 src="https://storage.googleapis.com/a1aa/image/HvB8j3VnQT2z-zM3fnxjnxOD0kXS8xjRIVLylkLMTPU.jpg" width="600" />
        </div>
    </div>
    <div class="text-center mb-8">
        <h2 class="text-lg" <a href="/Home/ChonLevel"></a>Bắt đầu học ngay!</h2>
        <button class="btn">Bấm vào đây</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="col-span-1 text-center">
            <h2 class="text-lg">Học từ vựng</h2>
            <img class="w-full h-auto" height="300"
                 src="https://storage.googleapis.com/a1aa/image/g_muQKQU5q0Nofanks7MBs04BIVohhWF_FfsWE5iJdc.jpg" width="400" />
            <a class="text-lg text-blue-500 block mt-2" href="/Home/chonlevel">Click vào đây</a>
        </div>
        <div class="col-span-1 text-center">
            <h2 class="text-lg">Học ngữ pháp</h2>
            <img class="w-full h-auto" height="300"
                 src="https://storage.googleapis.com/a1aa/image/wnOhn2QS1Hkf3N5eoQxXj1LEOTqB4lSPQ6b9JuVM9Wk.jpg" width="400" />
            <a class="text-lg text-blue-500 block mt-2" href="/Home/chonlevel">Click vào đây</a>
        </div>
        <div class="col-span-1 text-center">
            <h2 class="text-lg">Mini test</h2>
            <img class="w-full h-auto" height="300"
                 src="https://storage.googleapis.com/a1aa/image/KMhXzNrEOBei-JTV3u_87_HMhtOVUtkrUEvCUPZDeng.jpg" width="400" />
            <a class="text-lg text-blue-500 block mt-2" href="/Home/MiniTest">Click vào đây</a>
        </div>
    </div>
</div>


